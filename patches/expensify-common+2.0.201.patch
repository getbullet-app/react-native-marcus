+// PATCHED (react-native-marcus): `Logger` is a class instance, and
+// react-native-worklets >= 0.10 refuses to copy class instances into a worklet
+// runtime ("Cannot copy value of type `Logger`"). `parseExpensiMark` captures
+// the ExpensiMark class in its worklet closure, which drags this static along,
+// so it has to be a plain object. Only `alert` is ever called, on the
+// missing-report-name path in the <mention-report> replacement.
+ExpensiMark.Log = {
+    alert: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    hmmm: () => undefined,
+    client: () => undefined,
+};
