{
  "name": "@expensify/react-native-live-markdown",
  "version": "0.1.336",
  "description": "Drop-in replacement for React Native's TextInput component with Markdown formatting.",
  "author": "Expensify, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Expensify/react-native-live-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/expensify/react-native-live-markdown/issues"
  },
  "homepage": "https://github.com/expensify/react-native-live-markdown#readme",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "example": "npm run --workspace=@expensify/react-native-live-markdown-example",
    "prepare": "bob build && node scripts/bundle-parser.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "watch": "nodemon --watch src --ext 'ts tsx js jsx json' --exec npm run prepare"
  },
  "workspaces": [
    "./example",
    "./WebExample"
  ],
  "files": [
    "src",
    "lib",
    "mock",
    "android",
    "apple",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!apple/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "dependencies": {
    "emoji-regex": "^10.6.0",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0"
  },
  "peerDependencies": {
    "expensify-common": ">=2.0.189",
    "react": "*",
    "react-native": ">=0.81",
    "react-native-worklets": ">=0.7.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.85.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "expensify-common": "2.0.189",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^29.7.0",
    "kleur": "^4.1.5",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.0",
    "prettier": "2.8.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-web": "^0.20.0",
    "react-native-worklets": "0.10.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/WebExample/__tests__/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ],
    "exclude": "**/+(parseMicroMark.ts|__tests__|__fixtures__|__mocks__)/**"
  },
  "codegenConfig": {
    "name": "RNLiveMarkdownSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.expensify.livemarkdown"
    },
    "ios": {
      "componentProvider": {
        "MarkdownTextInputDecoratorView": "MarkdownTextInputDecoratorComponentView"
      }
    }
  }
}
